{
    "build" : "1",
    "class" : "{{config('controller.class')}}",
    "meta": {
      "author": "Remco (remco@workandtravel.world)",
      "title" : "Example.com | Debug ({{config('framework.version')}})",
      "description" : "Example.com | Debug",
      "keywords" : "Example.com, Debug"
    },
    "function" : "{{config('controller.function')}}",
    "script" : [
        "<script src=\"\/Js\/Priya\/0.3.18\/Priya.js?{{config('framework.version')}}.{{$this.build}}\"></script>"
    ],
    "link" : [
        "<link rel=\"stylesheet\" href=\"\/{{file.basename($this.class)}}\/Css\/{{$this.function|>string.uppercase.first|>string.replace:'_':'.'}}.css?{{config('framework.version')}}.{{$this.build}}\">",
        "<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\">",
        "<link href=\"https:\/\/fonts.googleapis.com\/css2?family=Source+Sans+Pro:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&display=swap\" rel=\"stylesheet\">"
    ],
    "template" : {
        "name" : "{{file.basename($this.#rootNode.class)}}/{{$this.#rootNode.function|>string.uppercase.first|>string.replace:'_':'.'}}",
        "url" : "{{config('controller.dir.view')}}{{$this.name}}.tpl"
    },
    "html" : {
        "content" : {
            "body" : "{{require($this.#rootNode.template.url)}}",
            "#attr": "{{$this.#property}}"
        },
        "head" : {
            "author" : "{{$this.#rootNode.meta.author}}",
            "title" : "{{$this.#rootNode.meta.title}}",
            "description" : "{{$this.#rootNode.meta.description}}",
            "keywords" : "{{$this.#rootNode.meta.keywords}}"
        }
    }
}